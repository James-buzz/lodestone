{
    "name": "lodestone/lodestone",
    "description": "Server-driven UI for Laravel admin panels. Build pages, tables, forms and buttons with PHP builders; Lodestone draws them with React and shadcn and calls your callbacks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "inertia",
        "react",
        "shadcn",
        "admin",
        "dashboard"
    ],
    "authors": [
        {
            "name": "James Lomax"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Lodestone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lodestone\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lodestone\\LodestoneServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/.github",
            "/docs",
            "/tests",
            "/phpunit.xml",
            "/CLAUDE.md",
            "/package.json",
            "/package-lock.json"
        ]
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "lint": "pint",
        "test": "phpunit"
    }
}
